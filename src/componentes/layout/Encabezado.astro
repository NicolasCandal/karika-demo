---
// Encabezado fijo. Va transparente mientras esté sobre el hero y toma
// fondo claro recién cuando lo deja atrás, para no partir la imagen con
// una barra blanca. Un velo degradado sostiene el contraste del texto
// durante ese tramo. Ver los comentarios del script y del CSS.
import Logo from '../marca/Logo.astro';
import { enlacesNavegacion } from '../../datos/navegacion.js';
---

<header class="encabezado" data-encabezado>
  <div class="encabezado__interior">
    <a href="#inicio" class="encabezado__marca" aria-label="Karika, ir al inicio">
      <Logo tamano={40} decorativo />
      <span class="encabezado__nombre">Karika</span>
    </a>

    <nav class="encabezado__nav" aria-label="Navegación principal">
      <ul class="encabezado__lista">
        {
          enlacesNavegacion.map((enlace) => (
            <li>
              <a href={enlace.href}>{enlace.etiqueta}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      class="encabezado__boton-menu"
      aria-expanded="false"
      aria-controls="menu-movil"
      data-abrir-menu
    >
      Menú
    </button>
  </div>
</header>

<script>
  const encabezado = document.querySelector<HTMLElement>('[data-encabezado]');
  const hero = document.getElementById('inicio');

  if (encabezado) {
    const marcar = (desplazado: boolean) =>
      encabezado.classList.toggle('encabezado--desplazado', desplazado);

    if (hero) {
      // El encabezado toma fondo claro recién cuando deja de estar sobre el
      // hero. Antes bastaban 24px de scroll y la barra se volvía blanca con
      // la foto todavía a la vista, que es justo lo que se quería evitar.
      //
      // El margen negativo arriba encoge la zona observada la altura del
      // propio encabezado: mientras quede hero por debajo de esa línea,
      // sigue habiendo intersección y la barra se mantiene transparente.
      let observador: IntersectionObserver | null = null;

      const observarHero = () => {
        observador?.disconnect();

        observador = new IntersectionObserver(([entrada]) => marcar(!entrada.isIntersecting), {
          rootMargin: `-${encabezado.offsetHeight}px 0px 0px 0px`,
          threshold: 0,
        });

        observador.observe(hero);
      };

      observarHero();

      // El hero mide 100svh, así que su alto cambia al girar el teléfono o
      // al aparecer y desaparecer la barra del navegador.
      window.addEventListener('resize', observarHero);
    } else {
      // Sin hero (otras páginas), alcanza con un umbral de scroll.
      const porScroll = () => marcar(window.scrollY > 24);
      porScroll();
      window.addEventListener('scroll', porScroll, { passive: true });
    }
  }
</script>

<style>
  .encabezado {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    color: var(--tinta-clara);
    transition:
      background-color var(--duracion-transicion) var(--easing-estandar),
      color var(--duracion-transicion) var(--easing-estandar),
      border-color var(--duracion-transicion) var(--easing-estandar);
    border-bottom: 1px solid transparent;
  }

  /*
    Mientras la barra va transparente sobre el hero, el texto blanco tiene
    que sobrevivir a lo que pase por debajo: arriba del todo hay azul
    marino, pero a media altura pasan los envases claros y los enlaces se
    volvían ilegibles. Este velo lo resuelve sin pintar la barra: sobre el
    azul es invisible, y sobre la foto clara sostiene el contraste.
  */
  .encabezado::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-azul-900) 78%, transparent),
      color-mix(in srgb, var(--color-azul-900) 45%, transparent) 60%,
      transparent
    );
    opacity: 1;
    transition: opacity var(--duracion-transicion) var(--easing-estandar);
  }

  /* Con fondo claro el velo sobra. */
  .encabezado--desplazado::before {
    opacity: 0;
  }

  .encabezado--desplazado {
    background-color: color-mix(in srgb, var(--color-bruma) 88%, transparent);
    backdrop-filter: blur(10px);
    color: var(--tinta);
    border-bottom-color: var(--filete);
  }

  .encabezado__interior {
    width: 100%;
    max-width: var(--ancho-contenido);
    margin-inline: auto;
    padding: var(--espacio-2) var(--canal);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-3);
  }

  .encabezado__marca {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
    text-decoration: none;
  }

  .encabezado__nombre {
    font-family: var(--fuente-display);
    font-size: var(--texto-20);
    text-transform: uppercase;
    letter-spacing: var(--interletra-display);
  }

  .encabezado__nav {
    display: none;
  }

  .encabezado__lista {
    display: flex;
    gap: var(--espacio-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--texto-15);
  }

  .encabezado__lista a {
    text-decoration: none;
    padding-block: var(--espacio-1);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duracion-transicion) var(--easing-estandar);
  }

  .encabezado__lista a:hover {
    border-bottom-color: currentColor;
  }

  .encabezado__boton-menu {
    background: none;
    border: 1px solid currentColor;
    border-radius: var(--radio-chico);
    padding: var(--espacio-1) var(--espacio-2);
    font-size: var(--texto-15);
    cursor: pointer;
  }

  @media (min-width: 60rem) {
    .encabezado__nav {
      display: block;
    }

    .encabezado__boton-menu {
      display: none;
    }
  }
</style>
