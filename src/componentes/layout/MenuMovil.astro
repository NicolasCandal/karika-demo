---
// Panel de navegación móvil. Sin framework: es un <dialog> nativo
// controlado con JS plano, con lo que el foco atrapado y el cierre con
// Escape vienen gratis del elemento.
import Logo from '../marca/Logo.astro';
import { enlacesNavegacion, enlaceInstagram, usuarioInstagram } from '../../datos/navegacion.js';
---

<dialog id="menu-movil" class="menu banda-oscura" aria-label="Menú de navegación">
  <div class="menu__encabezado">
    <Logo tamano={40} decorativo />
    <button type="button" class="menu__cerrar" data-cerrar-menu aria-label="Cerrar menú">
      <span aria-hidden="true">✕</span>
    </button>
  </div>

  <nav aria-label="Navegación móvil">
    <ul class="menu__lista">
      {
        enlacesNavegacion.map((enlace) => (
          <li>
            <a href={enlace.href} data-cerrar-menu>
              {enlace.etiqueta}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a class="menu__instagram" href={enlaceInstagram} target="_blank" rel="noopener noreferrer">
    {usuarioInstagram}
  </a>
</dialog>

<script>
  const dialogo = document.getElementById('menu-movil') as HTMLDialogElement | null;
  const botonAbrir = document.querySelector<HTMLButtonElement>('[data-abrir-menu]');
  const botonesCerrar = document.querySelectorAll<HTMLElement>('[data-cerrar-menu]');

  if (dialogo && botonAbrir) {
    botonAbrir.addEventListener('click', () => {
      dialogo.showModal();
      botonAbrir.setAttribute('aria-expanded', 'true');
    });

    // No confiamos solo en el evento "close" para resetear aria-expanded:
    // en el cierre explícito lo actualizamos directo. El listener queda
    // como respaldo para el cierre nativo con Escape.
    const cerrar = () => {
      dialogo.close();
      botonAbrir.setAttribute('aria-expanded', 'false');
    };

    botonesCerrar.forEach((boton) => boton.addEventListener('click', cerrar));

    dialogo.addEventListener('close', () => {
      botonAbrir.setAttribute('aria-expanded', 'false');
    });

    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) cerrar();
    });
  }
</script>

<style>
  .menu {
    border: none;
    padding: var(--espacio-3) var(--canal) var(--espacio-6);
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    background: linear-gradient(168deg, var(--color-azul-900), var(--color-azul-800));
    color: var(--tinta-clara);
    display: flex;
    flex-direction: column;
  }

  .menu::backdrop {
    background-color: var(--velo-hero);
  }

  .menu__encabezado {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu__cerrar {
    background: none;
    border: 1px solid var(--filete-oro);
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    color: inherit;
    cursor: pointer;
  }

  .menu__lista {
    list-style: none;
    margin: var(--espacio-6) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--espacio-4);
  }

  .menu__lista a {
    font-family: var(--fuente-display);
    font-size: var(--texto-34);
    text-transform: uppercase;
    letter-spacing: var(--interletra-display);
    text-decoration: none;
    color: var(--color-blanco);
  }

  .menu__instagram {
    margin-top: auto;
    padding-top: var(--espacio-4);
    border-top: 1px solid var(--filete-oro);
    font-size: var(--texto-15);
    color: var(--color-oro);
    text-decoration: none;
  }

  @media (min-width: 60rem) {
    .menu {
      display: none;
    }
  }
</style>
