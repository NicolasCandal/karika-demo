---
// Pie: emblema, Instagram y línea legal.
// No se lista dirección: no hay local físico.
//
// ANTES DE PUBLICAR (no aplica mientras esto sea una demo privada para
// mostrarle al cliente): hay que sumar acá la razón social y el RFC, y el
// aviso de privacidad, que es obligatorio por la LFPDPPP mexicana en
// cuanto el sitio quede accesible al público.
import Logo from '../marca/Logo.astro';
import { enlaceInstagram, usuarioInstagram } from '../../datos/navegacion.js';

const anio = new Date().getFullYear();
---

<footer class="pie banda-oscura">
  <div class="pie__interior">
    <div class="pie__marca">
      <Logo tamano={56} decorativo />
      <div>
        <p class="pie__nombre">Karika</p>
        <p class="pie__lema">Distribución de skincare coreano · Envíos a todo México</p>
      </div>
    </div>

    <a
      class="pie__instagram"
      href={enlaceInstagram}
      target="_blank"
      rel="noopener noreferrer"
      data-evento="clic_instagram"
    >
      {usuarioInstagram}
    </a>
  </div>

  <div class="pie__legal">
    <p>© {anio} Karika</p>
  </div>
</footer>

<style>
  .pie {
    background-color: var(--color-azul-900);
    color: var(--tinta-clara);
    padding-block: var(--espacio-6) var(--espacio-4);
  }

  .pie__interior,
  .pie__legal {
    width: 100%;
    max-width: var(--ancho-contenido);
    margin-inline: auto;
    padding-inline: var(--canal);
  }

  .pie__interior {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-4);
    flex-wrap: wrap;
    padding-bottom: var(--espacio-4);
    border-bottom: 1px solid var(--filete-oro);
  }

  .pie__marca {
    display: flex;
    align-items: center;
    gap: var(--espacio-3);
  }

  .pie__nombre {
    font-family: var(--fuente-display);
    font-size: var(--texto-26);
    text-transform: uppercase;
    letter-spacing: var(--interletra-display);
    color: var(--color-blanco);
  }

  .pie__lema {
    margin-top: var(--espacio-1);
    font-size: var(--texto-15);
    color: var(--tinta-clara-tenue);
  }

  .pie__instagram {
    font-size: var(--texto-17);
    color: var(--color-oro);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duracion-transicion) var(--easing-estandar);
  }

  .pie__instagram:hover {
    border-bottom-color: var(--color-oro);
  }

  .pie__legal {
    margin-top: var(--espacio-4);
    display: flex;
    justify-content: space-between;
    gap: var(--espacio-2);
    flex-wrap: wrap;
    font-size: var(--texto-13);
    /* 58%: al 45% quedaba en 4.4:1, apenas por debajo de AA. */
    color: color-mix(in srgb, var(--color-blanco) 58%, transparent);
  }
</style>
