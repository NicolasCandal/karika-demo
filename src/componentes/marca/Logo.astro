---
// Emblema de Karika. Es el logo real del cliente, recortado del hero por
// scripts/extraer-logo.mjs — no una marca inventada.
//
// PENDIENTE (docs/brief.md, pendiente 2): sigue faltando el vectorial.
// Al ser un PNG recortado no escala más allá de su resolución nativa, y
// por eso el loader ya no lo traza con stroke-dasharray.
import { Image } from 'astro:assets';
import emblema from '../../activos/imagenes/marca/logo-karika.png';

interface Props {
  tamano?: number;
  class?: string;
  decorativo?: boolean;
}

const { tamano = 44, class: clase, decorativo = false } = Astro.props;
---

<Image
  class:list={['logo', clase]}
  src={emblema}
  alt={decorativo ? '' : 'Karika Distribution'}
  width={tamano * 2}
  height={tamano * 2}
  densities={[1, 2]}
  quality={82}
  style={`width:${tamano}px;height:${tamano}px`}
/>

<style>
  .logo {
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
