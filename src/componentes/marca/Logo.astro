---
// Emblema de Karika. Es el logo real del cliente, recortado del hero por
// scripts/preparar-hero.mjs — no una marca inventada.
//
// Se guarda a resolución nativa (336px) con el círculo y la transparencia
// ya horneados en el PNG, así que acá no hace falta enmascararlo.
//
// PENDIENTE (docs/brief.md, pendiente 2): el vectorial sigue faltando.
// 336px cubre todos los usos actuales —el mayor es el loader, a 96 CSS px,
// que en pantallas 3x pide 288—, pero no da para un uso grande: una
// cabecera a sangre o material impreso necesitan el SVG del cliente.
import { Image } from 'astro:assets';
import emblema from '../../activos/imagenes/marca/logo-karika.png';

interface Props {
  tamano?: number;
  class?: string;
  decorativo?: boolean;
}

const { tamano = 44, class: clase, decorativo = false } = Astro.props;
---

<Image
  class:list={['logo', clase]}
  src={emblema}
  alt={decorativo ? '' : 'Karika Distribution'}
  width={tamano}
  height={tamano}
  densities={[1, 2, 3]}
  quality={86}
/>

<style>
  .logo {
    flex-shrink: 0;
  }
</style>
