---
// Botón/enlace con dos variantes. Si recibe `href` renderiza <a>, si no,
// <button> — para no forzar un <a> sin destino real.
//
// Sobre `.banda-oscura` las variantes se invierten solas: el primario
// pasa a dorado (el color del emblema) y el secundario a filete claro.
// Sin flechas pegadas al texto: es uno de los antipatrones de CLAUDE.md.
interface Props {
  href?: string;
  variante?: 'primario' | 'secundario';
  tipo?: 'button' | 'submit';
  externo?: boolean;
  class?: string;
}

const { href, variante = 'primario', tipo = 'button', externo = false, class: clase } = Astro.props;
const Etiqueta = href ? 'a' : 'button';
---

<Etiqueta
  class:list={['boton', `boton--${variante}`, clase]}
  href={href}
  type={href ? undefined : tipo}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener noreferrer' : undefined}
>
  <slot />
</Etiqueta>

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--espacio-2) var(--espacio-4);
    border-radius: var(--radio-chico);
    border: 1px solid transparent;
    font-family: var(--fuente-cuerpo);
    font-size: var(--texto-15);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duracion-transicion) var(--easing-estandar),
      border-color var(--duracion-transicion) var(--easing-estandar),
      color var(--duracion-transicion) var(--easing-estandar);
  }

  .boton--primario {
    background-color: var(--color-azul-900);
    border-color: var(--color-azul-900);
    color: var(--color-blanco);
  }

  .boton--primario:hover {
    background-color: var(--color-agua-800);
    border-color: var(--color-agua-800);
  }

  .boton--secundario {
    background-color: transparent;
    border-color: var(--filete-fuerte);
    color: var(--tinta);
  }

  .boton--secundario:hover {
    border-color: var(--color-agua-800);
    color: var(--color-agua-800);
  }

  /* Sobre azul marino */
  :global(.banda-oscura) .boton--primario {
    background-color: var(--color-oro);
    border-color: var(--color-oro);
    color: var(--color-azul-900);
  }

  :global(.banda-oscura) .boton--primario:hover {
    background-color: var(--color-oro-claro);
    border-color: var(--color-oro-claro);
  }

  :global(.banda-oscura) .boton--secundario {
    border-color: var(--filete-oro);
    color: var(--color-blanco);
  }

  :global(.banda-oscura) .boton--secundario:hover {
    border-color: var(--color-oro);
    color: var(--color-oro-claro);
  }
</style>
