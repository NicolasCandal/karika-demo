---
// Encabezado con la tipografía de display (Bodoni). `nivel` controla la
// etiqueta semántica (h1/h2/h3) por separado del tamaño visual (`tamano`),
// para no acoplar jerarquía de documento con jerarquía visual.
interface Props {
  nivel?: 1 | 2 | 3;
  tamano?: 'grande' | 'chico';
}

const { nivel = 2, tamano = 'grande' } = Astro.props;
const Etiqueta = `h${nivel}` as 'h1' | 'h2' | 'h3';
---

<Etiqueta class:list={['titulo', tamano === 'chico' && 'titulo--chico']}>
  <slot />
</Etiqueta>

<style>
  .titulo {
    font-size: var(--texto-display-1);
    color: var(--color-azul-900);
  }

  .titulo--chico {
    font-size: var(--texto-display-2);
  }
</style>
