---
// Envoltorio de ancho máximo y padding lateral consistente. Lo usa toda
// sección para no repetir el mismo max-width suelto en cada CSS.
interface Props {
  etiqueta?: keyof HTMLElementTagNameMap;
}

const { etiqueta: Etiqueta = 'div' } = Astro.props;
---

<Etiqueta class="contenedor">
  <slot />
</Etiqueta>

<style>
  .contenedor {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--espacio-3);
  }
</style>
