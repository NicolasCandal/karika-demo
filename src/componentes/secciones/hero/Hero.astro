---
// Hero con la imagen provista por el cliente. Decisión explícita del
// cliente usarla tal cual, sabiendo que:
// - trae el copy y el logo quemados en los píxeles, así que el titular
//   visible no es texto real (por eso el <h1> va oculto visualmente pero
//   presente para lectores de pantalla y buscadores, y el alt reproduce
//   el texto de la imagen como pide WCAG 1.1.1 para imágenes de texto);
// - mide 1536x1024, por debajo de los 2560px que pedía docs/brief.md;
// - reproduce dos antipatrones ya descartados en CLAUDE.md (etiqueta en
//   mayúsculas sostenidas y una palabra del titular en otro color).
// Los CTA van debajo de la imagen y no encima, para no chocar con el
// texto que la imagen ya trae.
import { Picture } from 'astro:assets';
import Boton from '../../comunes/Boton.astro';
import Contenedor from '../../comunes/Contenedor.astro';
import heroImagen from '../../../activos/imagenes/hero/hero-provisorio.png';
---

<section id="inicio" class="hero">
  <h1 class="hero__titular-accesible">Piel que se nota, cuidado que se elige.</h1>

  <Picture
    class="hero__imagen"
    src={heroImagen}
    alt="Karika Distribution. Exclusividad que se nota, piel que brilla. Limpieza, exclusividad, resultados. Cuidado facial y corporal con fórmulas seleccionadas para resultados visibles. En la foto: Birch Juice Moisturizing Sun Cream SPF50+ de SKIN1004, la mascarilla en barra Madagascar Centella y el 345 Relief Cream Mist de Dr. Althea, sobre piedra y agua en penumbra azul marino."
    widths={[480, 768, 1200, 1536]}
    sizes="100vw"
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    quality={72}
    loading="eager"
    fetchpriority="high"
  />

  <div class="hero__acciones-banda">
    <Contenedor etiqueta="div">
      <p class="hero__bajada">
        Catálogo seleccionado de skincare coreano, con envíos a todo México.
      </p>
      <div class="hero__acciones">
        <Boton href="#contacto">Escribir por WhatsApp</Boton>
        <Boton href="#productos" variante="secundario">Ver catálogo</Boton>
      </div>
    </Contenedor>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-azul-900);
  }

  /* El titular visible vive dentro de la imagen; este <h1> mantiene la
     jerarquía del documento para lectores de pantalla y buscadores. */
  .hero__titular-accesible {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hero__imagen {
    width: 100%;
    height: auto;
  }

  .hero__acciones-banda {
    padding-block: var(--espacio-4);
    background-color: var(--color-azul-900);
    color: var(--color-blanco);
  }

  .hero__bajada {
    font-size: var(--texto-cuerpo-grande);
    max-width: 40ch;
    color: color-mix(in srgb, var(--color-blanco) 88%, transparent);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
    margin-top: var(--espacio-3);
  }

  .hero__acciones :global(.boton) {
    background-color: var(--color-agua-800);
    border-color: var(--color-agua-800);
  }

  .hero__acciones :global(.boton:hover) {
    background-color: var(--color-agua-600);
    border-color: var(--color-agua-600);
  }

  .hero__acciones :global(.boton--secundario) {
    background-color: transparent;
    color: var(--color-blanco);
    border-color: color-mix(in srgb, var(--color-blanco) 60%, transparent);
  }

  .hero__acciones :global(.boton--secundario:hover) {
    background-color: color-mix(in srgb, var(--color-blanco) 12%, transparent);
    border-color: var(--color-blanco);
  }
</style>
