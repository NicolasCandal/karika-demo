---
// Hero a sangre con velo de azul marino del lado del texto, como pide
// docs/brief.md (sección 4).
//
// La imagen es el bodegón del cliente recortado por
// scripts/preparar-hero.mjs: la original traía el titular, la bajada y el
// logo quemados en el tercio izquierdo, lo que obligaba a esconder el
// <h1>. Con la franja de texto fuera, el titular vuelve a ser texto real
// en la tipografía de display y la imagen queda solo como imagen.
import { Picture } from 'astro:assets';
import Boton from '../../comunes/Boton.astro';
import { enlaceInstagram } from '../../../datos/navegacion.js';
import heroImagen from '../../../activos/imagenes/hero/hero-productos.jpg';
---

<section id="inicio" class="hero banda-oscura">
  <div class="hero__figura">
    <Picture
      class="hero__imagen"
      src={heroImagen}
      alt="Protector solar Birch Juice, mascarilla Madagascar Centella y bruma 345 Relief sobre piedra oscura, con reflejos de agua"
      widths={[480, 768, 916]}
      sizes="(min-width: 60rem) 52vw, 100vw"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={74}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__velo"></div>
  </div>

  <div class="hero__contenido">
    <p class="hero__etiqueta">Distribución de skincare coreano en México</p>
    <h1 class="hero__titular">Piel que se nota, cuidado que se elige</h1>
    <p class="hero__bajada">
      Catálogo seleccionado de fórmulas coreanas, con envíos a todo el país y venta al mayoreo desde
      cinco piezas.
    </p>
    <div class="hero__acciones">
      <Boton href="#productos">Ver el catálogo</Boton>
      <Boton href={enlaceInstagram} variante="secundario" externo>Seguir en Instagram</Boton>
    </div>
  </div>

  <a class="hero__indicador" href="#propuesta" aria-label="Ir al contenido">
    <span class="hero__indicador-linea"></span>
    Desliza para descubrir
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    isolation: isolate;
    background-color: var(--color-azul-900);
    overflow: hidden;
  }

  /* En móvil la foto es el fondo de toda la sección; en escritorio pasa a
     ocupar la mitad derecha, que le sienta mejor a una toma vertical y
     evita agrandarla de más. */
  .hero__figura {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
  }

  /* En móvil el velo se densifica hacia abajo: deja respirar la foto
     arriba y garantiza contraste donde cae el texto. */
  .hero__velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-azul-900) 62%, transparent) 0%,
      color-mix(in srgb, var(--color-azul-900) 86%, transparent) 38%,
      color-mix(in srgb, var(--color-azul-900) 95%, transparent) 100%
    );
  }

  .hero__contenido {
    position: relative;
    width: 100%;
    max-width: var(--ancho-contenido);
    margin-inline: auto;
    padding: calc(var(--espacio-8) + var(--espacio-2)) var(--canal) var(--espacio-7);
  }

  @media (min-width: 60rem) {
    .hero__figura {
      left: auto;
      width: 48%;
    }

    .hero__imagen {
      object-position: 55% center;
    }

    /* Sobre escritorio el velo solo difumina la costura con el bloque de
       texto, para que no se lea como un recorte pegado. */
    .hero__velo {
      background: linear-gradient(
        90deg,
        var(--color-azul-900) 0%,
        color-mix(in srgb, var(--color-azul-900) 55%, transparent) 22%,
        transparent 55%
      );
    }

    /*
      El texto ocupa la columna izquierda de una grilla real.
      Antes esto era `padding-right: 50%`, y era un error: el porcentaje
      de un padding se resuelve contra el bloque contenedor —acá, el ancho
      completo de la ventana—, no contra la caja del elemento. En una
      pantalla de 1920 daba 952px de padding y dejaba la columna de texto
      en 151px, rompiendo el titular palabra por palabra.

      El contenedor del hero es más ancho que el del resto de la página
      para que la columna respire sin meterse debajo de la foto.
    */
    .hero__contenido {
      max-width: 82rem;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--espacio-6);
    }

    .hero__contenido > * {
      grid-column: 1;
    }
  }

  .hero__etiqueta {
    font-size: var(--texto-15);
    color: var(--color-oro);
    margin-bottom: var(--espacio-3);
  }

  .hero__titular {
    font-size: clamp(2.125rem, 1.3rem + 2.9vw, 3.75rem);
    text-transform: uppercase;
    letter-spacing: var(--interletra-display);
    color: var(--color-blanco);
    max-width: 14ch;
    text-wrap: balance;
  }

  .hero__bajada {
    margin-top: var(--espacio-3);
    max-width: 38ch;
    font-size: var(--texto-20);
    color: var(--tinta-clara);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
    margin-top: var(--espacio-5);
  }

  .hero__indicador {
    position: absolute;
    left: 50%;
    bottom: var(--espacio-4);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
    font-size: var(--texto-13);
    letter-spacing: 0.08em;
    color: var(--tinta-clara-tenue);
    text-decoration: none;
  }

  .hero__indicador-linea {
    display: block;
    width: 1px;
    height: 2.25rem;
    background: linear-gradient(to bottom, transparent, var(--color-oro));
  }

  @media (max-width: 60rem) {
    .hero__imagen {
      object-position: 58% 30%;
    }
  }
</style>
