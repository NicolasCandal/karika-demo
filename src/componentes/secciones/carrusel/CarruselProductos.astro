---
// Carrusel con CSS scroll-snap puro: cero framework de cliente, inercia
// nativa en móvil (docs/brief.md, sección 4). Sin autoplay todavía — el
// brief lo deja para cuando se migre a Embla si hace falta loop/autoplay.
// El único JS es el de esta página: mover el scroll con los botones y
// anunciar el producto visible por aria-live.
// La tarjeta muestra el recorte del envase; la ficha completa del
// cliente (que trae el copy quemado, ilegible a 272px) se abre en un
// <dialog> nativo, con el mismo patrón sin framework que MenuMovil.
import { Picture } from 'astro:assets';
import Contenedor from '../../comunes/Contenedor.astro';
import Titulo from '../../comunes/Titulo.astro';
import { listaProductos } from '../../../datos/productos.js';
---

<section id="productos" class="carrusel">
  <Contenedor etiqueta="div">
    <Titulo nivel={2}>Catálogo</Titulo>

    <div class="carrusel__controles">
      <button
        type="button"
        class="carrusel__boton"
        data-carrusel-anterior
        aria-label="Producto anterior"
      >
        ‹
      </button>
      <button
        type="button"
        class="carrusel__boton"
        data-carrusel-siguiente
        aria-label="Producto siguiente"
      >
        ›
      </button>
    </div>

    <p class="visualmente-oculto" aria-live="polite" data-carrusel-anuncio></p>

    <ul class="carrusel__lista" tabindex="0" aria-label="Lista de productos" data-carrusel-lista>
      {
        listaProductos.map((producto) => (
          <li class="carrusel__item" data-carrusel-item data-nombre={producto.nombre}>
            <Picture
              class="carrusel__imagen"
              src={producto.imagen}
              alt={`${producto.marca} ${producto.nombre}, ${producto.presentacion}`}
              widths={[300, 600, 750]}
              sizes="(min-width: 48rem) 18rem, 70vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              quality={72}
              loading="lazy"
            />
            <p class="carrusel__marca">
              {producto.marca} · {producto.presentacion}
            </p>
            <h3 class="carrusel__nombre">{producto.nombre}</h3>
            <p class="carrusel__descripcion">{producto.descripcion}</p>
            <p class="carrusel__precio">{producto.precio ?? 'Precio: consultar por WhatsApp'}</p>
            <button
              type="button"
              class="carrusel__ver-ficha"
              data-abrir-ficha={producto.id}
              aria-haspopup="dialog"
            >
              Ver ficha completa
            </button>
          </li>
        ))
      }
    </ul>
  </Contenedor>

  {
    listaProductos.map((producto) => (
      <dialog class="ficha" id={`ficha-${producto.id}`} aria-label={`Ficha de ${producto.nombre}`}>
        <button type="button" class="ficha__cerrar" data-cerrar-ficha aria-label="Cerrar ficha">
          ✕
        </button>
        <Picture
          class="ficha__imagen"
          src={producto.ficha}
          alt={`Ficha de ${producto.marca} ${producto.nombre}, ${producto.presentacion}. ${producto.descripcion} Venta al mayoreo desde 5 piezas, envíos dentro de la República y atención personalizada.`}
          widths={[480, 960, 1440]}
          sizes="(min-width: 48rem) 40rem, 90vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          quality={72}
          loading="lazy"
        />
      </dialog>
    ))
  }
</section>

<script>
  const lista = document.querySelector<HTMLUListElement>('[data-carrusel-lista]');
  const botonAnterior = document.querySelector<HTMLButtonElement>('[data-carrusel-anterior]');
  const botonSiguiente = document.querySelector<HTMLButtonElement>('[data-carrusel-siguiente]');
  const anuncio = document.querySelector<HTMLElement>('[data-carrusel-anuncio]');

  if (lista && botonAnterior && botonSiguiente) {
    const desplazar = (direccion: 1 | -1) => {
      const item = lista.querySelector<HTMLElement>('[data-carrusel-item]');
      const ancho = item ? item.getBoundingClientRect().width + 16 : lista.clientWidth;
      lista.scrollBy({ left: ancho * direccion, behavior: 'smooth' });
    };

    botonAnterior.addEventListener('click', () => desplazar(-1));
    botonSiguiente.addEventListener('click', () => desplazar(1));
  }

  if (lista && anuncio) {
    const items = lista.querySelectorAll<HTMLElement>('[data-carrusel-item]');
    const observador = new IntersectionObserver(
      (entradas) => {
        const visible = entradas.find((entrada) => entrada.isIntersecting);
        if (visible) {
          anuncio.textContent = `Mostrando ${visible.target.getAttribute('data-nombre')}`;
        }
      },
      { root: lista, threshold: 0.6 },
    );

    items.forEach((item) => observador.observe(item));
  }

  // Diálogo de ficha completa. Igual que en MenuMovil, el cierre explícito
  // actualiza el estado a mano en vez de depender del evento "close".
  document.querySelectorAll<HTMLButtonElement>('[data-abrir-ficha]').forEach((boton) => {
    const id = boton.getAttribute('data-abrir-ficha');
    const dialogo = document.getElementById(`ficha-${id}`) as HTMLDialogElement | null;
    if (!dialogo) return;

    boton.addEventListener('click', () => dialogo.showModal());

    dialogo
      .querySelectorAll<HTMLElement>('[data-cerrar-ficha]')
      .forEach((cerrar) => cerrar.addEventListener('click', () => dialogo.close()));

    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });
  });
</script>

<style>
  .carrusel {
    padding-block: var(--espacio-7);
  }

  .carrusel__controles {
    display: flex;
    justify-content: flex-end;
    gap: var(--espacio-1);
    margin-top: var(--espacio-3);
  }

  .carrusel__boton {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--color-azul-900);
    background: var(--color-blanco);
    font-size: var(--texto-cuerpo-grande);
    cursor: pointer;
  }

  .carrusel__boton:hover {
    background-color: var(--color-agua-400);
  }

  .visualmente-oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .carrusel__lista {
    display: flex;
    gap: var(--espacio-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    list-style: none;
    margin: var(--espacio-2) 0 0;
    padding: 0 0 var(--espacio-2);
  }

  .carrusel__item {
    scroll-snap-align: start;
    flex: 0 0 min(80%, 20rem);
    background-color: var(--color-blanco);
    border-radius: var(--radio-medio);
    box-shadow: var(--sombra-baja);
    padding: var(--espacio-3);
    display: flex;
    flex-direction: column;
    gap: var(--espacio-1);
  }

  .carrusel__imagen {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radio-chico);
    background-color: var(--color-bruma);
  }

  .carrusel__ver-ficha {
    margin-top: var(--espacio-2);
    align-self: start;
    background: none;
    border: 1px solid var(--color-agua-800);
    color: var(--color-agua-800);
    border-radius: var(--radio-chico);
    padding: var(--espacio-1) var(--espacio-2);
    font-size: var(--texto-chico);
    font-weight: 600;
    cursor: pointer;
  }

  .carrusel__ver-ficha:hover {
    background-color: var(--color-agua-800);
    color: var(--color-blanco);
  }

  .ficha {
    border: none;
    padding: 0;
    max-width: min(90vw, 40rem);
    max-height: 90vh;
    background-color: var(--color-blanco);
    border-radius: var(--radio-medio);
    overflow: hidden;
  }

  .ficha::backdrop {
    background-color: var(--velo-hero);
  }

  .ficha__cerrar {
    position: absolute;
    top: var(--espacio-1);
    right: var(--espacio-1);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: none;
    background-color: var(--color-blanco);
    box-shadow: var(--sombra-baja);
    cursor: pointer;
  }

  .ficha__imagen {
    display: block;
    width: 100%;
    height: auto;
  }

  .carrusel__marca {
    font-size: var(--texto-chico);
    color: var(--color-agua-800);
  }

  .carrusel__nombre {
    font-family: var(--fuente-cuerpo);
    font-size: var(--texto-cuerpo-grande);
    font-weight: 700;
  }

  .carrusel__descripcion {
    font-size: var(--texto-chico);
    color: color-mix(in srgb, var(--color-azul-900) 75%, transparent);
  }

  .carrusel__precio {
    margin-top: auto;
    font-weight: 600;
  }
</style>
