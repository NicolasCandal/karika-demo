---
// Carrusel con CSS scroll-snap puro: cero framework de cliente, inercia
// nativa en móvil (docs/brief.md, sección 4). Sin autoplay — el brief lo
// deja para cuando se migre a Embla, si hace falta loop.
//
// Las tarjetas ya no llevan sombra ni fondo propio: son la foto del
// envase sobre un filete finísimo, para no caer en el antipatrón de
// "tarjetas idénticas con el mismo radio y la misma sombra gris".
import { Picture } from 'astro:assets';
import Seccion from '../../comunes/Seccion.astro';
import EncabezadoSeccion from '../../comunes/EncabezadoSeccion.astro';
import { listaProductos } from '../../../datos/productos.js';
---

<Seccion id="productos" rotulo="Catálogo" tono="claro">
  <div class="carrusel__encabezado">
    <EncabezadoSeccion
      etiqueta="Lo que distribuimos"
      titulo="Una selección, no un depósito"
      bajada="Fórmulas elegidas una por una. Escríbenos por Instagram para precios y disponibilidad."
    />

    <div class="carrusel__controles entrada">
      <button
        type="button"
        class="carrusel__boton"
        data-carrusel-anterior
        aria-label="Producto anterior"
      >
        <span aria-hidden="true">←</span>
      </button>
      <button
        type="button"
        class="carrusel__boton"
        data-carrusel-siguiente
        aria-label="Producto siguiente"
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <p class="visualmente-oculto" aria-live="polite" data-carrusel-anuncio></p>

  <ul class="carrusel__lista" tabindex="0" aria-label="Lista de productos" data-carrusel-lista>
    {
      listaProductos.map((producto) => (
        <li class="carrusel__item entrada" data-carrusel-item data-nombre={producto.nombre}>
          <Picture
            class="carrusel__imagen"
            src={producto.imagen}
            alt={`${producto.marca} ${producto.nombre}, ${producto.presentacion}`}
            widths={[300, 600, 750]}
            sizes="(min-width: 60rem) 18rem, 70vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            quality={72}
            loading="lazy"
          />
          <p class="carrusel__marca">
            {producto.marca} · {producto.presentacion}
          </p>
          <h3 class="carrusel__nombre">{producto.nombre}</h3>
          <p class="carrusel__descripcion">{producto.descripcion}</p>
        </li>
      ))
    }
  </ul>
</Seccion>

<script>
  const lista = document.querySelector<HTMLUListElement>('[data-carrusel-lista]');
  const botonAnterior = document.querySelector<HTMLButtonElement>('[data-carrusel-anterior]');
  const botonSiguiente = document.querySelector<HTMLButtonElement>('[data-carrusel-siguiente]');
  const anuncio = document.querySelector<HTMLElement>('[data-carrusel-anuncio]');

  if (lista && botonAnterior && botonSiguiente) {
    const desplazar = (direccion: 1 | -1) => {
      const item = lista.querySelector<HTMLElement>('[data-carrusel-item]');
      const ancho = item ? item.getBoundingClientRect().width + 24 : lista.clientWidth;
      lista.scrollBy({ left: ancho * direccion, behavior: 'smooth' });
    };

    botonAnterior.addEventListener('click', () => desplazar(-1));
    botonSiguiente.addEventListener('click', () => desplazar(1));

    // Los botones se apagan en los extremos en vez de quedar activos sin efecto.
    const actualizarExtremos = () => {
      const margen = 8;
      botonAnterior.disabled = lista.scrollLeft <= margen;
      botonSiguiente.disabled = lista.scrollLeft + lista.clientWidth >= lista.scrollWidth - margen;
    };

    actualizarExtremos();
    lista.addEventListener('scroll', actualizarExtremos, { passive: true });
    window.addEventListener('resize', actualizarExtremos);
  }

  if (lista && anuncio) {
    const items = lista.querySelectorAll<HTMLElement>('[data-carrusel-item]');
    const observador = new IntersectionObserver(
      (entradas) => {
        const visible = entradas.find((entrada) => entrada.isIntersecting);
        if (visible) {
          anuncio.textContent = `Mostrando ${visible.target.getAttribute('data-nombre')}`;
        }
      },
      { root: lista, threshold: 0.6 },
    );

    items.forEach((item) => observador.observe(item));
  }
</script>

<style>
  .carrusel__encabezado {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--espacio-4);
    flex-wrap: wrap;
  }

  .carrusel__controles {
    display: flex;
    gap: var(--espacio-1);
    margin-bottom: var(--espacio-6);
  }

  .carrusel__boton {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--filete-fuerte);
    background: none;
    color: var(--tinta);
    font-size: var(--texto-17);
    cursor: pointer;
    transition:
      background-color var(--duracion-transicion) var(--easing-estandar),
      border-color var(--duracion-transicion) var(--easing-estandar),
      opacity var(--duracion-transicion) var(--easing-estandar);
  }

  .carrusel__boton:hover:not(:disabled) {
    background-color: var(--color-azul-900);
    border-color: var(--color-azul-900);
    color: var(--color-blanco);
  }

  .carrusel__boton:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .carrusel__lista {
    display: flex;
    gap: var(--espacio-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0 0 var(--espacio-2);
  }

  .carrusel__lista::-webkit-scrollbar {
    display: none;
  }

  .carrusel__item {
    scroll-snap-align: start;
    flex: 0 0 min(70%, 18rem);
    display: flex;
    flex-direction: column;
  }

  .carrusel__imagen {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--filete);
    border-radius: var(--radio-chico);
    background-color: var(--color-elevado);
  }

  .carrusel__marca {
    margin-top: var(--espacio-3);
    font-size: var(--texto-13);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-agua-800);
  }

  .carrusel__nombre {
    margin-top: var(--espacio-1);
    font-family: var(--fuente-cuerpo);
    font-size: var(--texto-17);
    font-weight: 600;
    line-height: 1.35;
  }

  .carrusel__descripcion {
    margin-top: var(--espacio-1);
    font-size: var(--texto-15);
    color: var(--tinta-suave);
  }
</style>
