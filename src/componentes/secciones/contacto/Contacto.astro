---
// Contacto reducido a Instagram por pedido del cliente: por ahora es el
// único canal. Se retiraron el formulario, el WhatsApp y el "copiar
// teléfono", que dependían de datos que además nunca llegaron
// (docs/brief.md, pendiente 5).
//
// Al no quedar estado de cliente en esta sección, ya no hay isla: es
// HTML estático y el sitio no envía JS por este bloque.
import Seccion from '../../comunes/Seccion.astro';
import EncabezadoSeccion from '../../comunes/EncabezadoSeccion.astro';
import Boton from '../../comunes/Boton.astro';
import { enlaceInstagram, usuarioInstagram } from '../../../datos/navegacion.js';
---

<Seccion id="contacto" rotulo="Contacto" tono="oscuro" class="contacto">
  <div class="contacto__caja">
    <EncabezadoSeccion
      etiqueta="Atención personalizada"
      titulo="Hablemos de tu pedido"
      bajada="Escríbenos por Instagram para conocer precios, disponibilidad y condiciones de mayoreo."
    />

    <div class="contacto__acciones entrada">
      <Boton href={enlaceInstagram} externo class="contacto__cta">Escríbenos por Instagram</Boton>
      <p class="contacto__usuario">{usuarioInstagram}</p>
    </div>
  </div>
</Seccion>

<style>
  .contacto__caja {
    max-width: 46rem;
  }

  .contacto__acciones {
    display: flex;
    align-items: center;
    gap: var(--espacio-3);
    flex-wrap: wrap;
  }

  .contacto__usuario {
    font-size: var(--texto-15);
    letter-spacing: 0.04em;
    color: var(--tinta-clara-tenue);
  }
</style>
