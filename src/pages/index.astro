---
// Página única de la landing. Cada sección importada es autocontenida
// (su propio componente + CSS) y puede borrarse sin romper el resto,
// según la estructura de CLAUDE.md.
//
// Ya no hay sección de Ubicación: el cliente no tiene local físico.
import LayoutBase from '../layout/LayoutBase.astro';
import Hero from '../componentes/secciones/hero/Hero.astro';
import Propuesta from '../componentes/secciones/propuesta/Propuesta.astro';
import CarruselProductos from '../componentes/secciones/carrusel/CarruselProductos.astro';
import Beneficios from '../componentes/secciones/beneficios/Beneficios.astro';
import Contacto from '../componentes/secciones/contacto/Contacto.astro';
---

<LayoutBase
  titulo="Karika — Distribución de skincare coreano en México"
  descripcion="Distribuimos skincare coreano en México. Catálogo seleccionado, venta al mayoreo desde cinco piezas y envíos a todo el país."
>
  <Hero />
  <Propuesta />
  <CarruselProductos />
  <Beneficios />
  <Contacto />
</LayoutBase>
